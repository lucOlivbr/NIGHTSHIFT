[sub_resource type="AnimationNodeStateMachineTransition" id="EarlyLand"]
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachineTransition" id="NextJump"]
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachine" id="AirState"]
states/Takeoff/node = SubResource("JumpStart")
