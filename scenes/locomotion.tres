start_offset = 0.3958333
loop_mode = 1
stretch_time_scale = true

[sub_resource type="AnimationNodeBlendSpace1D" id="Gait"]
blend_point_0/node = SubResource("Walk")
blend_point_0/pos = 3.0
blend_point_1/node = SubResource("Run")
blend_point_1/pos = 6.5
min_space = 3.0
max_space = 6.5
sync_mode = 2
value_label = "Speed (m/s)"

[sub_resource type="AnimationNodeTimeScale" id="Pace"]

[sub_resource type="AnimationNodeBlend2" id="StartStop"]
