transitions = ["Takeoff", "Air", SubResource("ToAir"), "Air", "Land", SubResource("ToLand"), "Takeoff", "Land", SubResource("EarlyLand"), "Land", "Takeoff", SubResource("NextJump")]

[sub_resource type="AnimationNodeBlend2" id="Air"]
sync = true

[sub_resource type="AnimationNodeAnimation" id="SkateStance"]
animation = &"SkateStance"

[sub_resource type="AnimationNodeBlend2" id="Ride"]
